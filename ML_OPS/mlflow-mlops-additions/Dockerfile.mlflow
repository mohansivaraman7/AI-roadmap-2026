FROM python:3.11-slim

WORKDIR /mlflow

# Full mlflow package (not mlflow-skinny) — this container runs the
# tracking server + UI, which the skinny client package doesn't include.
RUN pip install --no-cache-dir mlflow

EXPOSE 5000

# Backend store (run/param/metric metadata) and artifact store (logged
# models) both live under /mlflow, which docker-compose mounts as a
# named volume so tracking history survives container restarts.
CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:///mlflow/mlflow.db", \
     "--default-artifact-root", "/mlflow/artifacts", \
     "--host", "0.0.0.0", \
     "--port", "5000"]
